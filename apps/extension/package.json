{
  "name": "job-autofill-copilot-extension",
  "displayName": "Job Autofill Copilot",
  "version": "0.1.0",
  "description": "Zero-hallucination AI autofill for job application forms, grounded in your resume and your own answers.",
  "author": "Rajas Deshpande",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.96",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "plasmo": "^0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "http://localhost/*"
    ],
    "permissions": [
      "storage",
      "cookies",
      "activeTab",
      "scripting",
      "sidePanel"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "externally_connectable": {
      "matches": [
        "http://localhost:3000/*"
      ]
    }
  }
}
